<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <!-- AGP 8.2 lint omits the supported device-protected domain names.
         https://developer.android.com/identity/data/autobackup#xml-syntax-android-12
         Suppress only those domain checks; keep both storage contexts excluded. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." tools:ignore="FullBackupContent" />
        <exclude domain="device_file" path="." tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="." tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="." tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." tools:ignore="FullBackupContent" />
        <exclude domain="device_file" path="." tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="." tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="." tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
